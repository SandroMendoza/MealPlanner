CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    darkModeEnabled INTEGER NOT NULL,
    language TEXT NOT NULL,
    currency TEXT NOT NULL,
    lockPastDates INTEGER NOT NULL,
    defaultCalendarView TEXT NOT NULL,
    readAloudEnabled INTEGER NOT NULL DEFAULT 0
);

selectSettings:
SELECT * FROM SettingsEntity WHERE id = 1;

upsertSettings:
INSERT OR REPLACE INTO SettingsEntity(id, darkModeEnabled, language, currency, lockPastDates, defaultCalendarView, readAloudEnabled)
VALUES (1, ?, ?, ?, ?, ?, ?);
