CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    darkModeEnabled INTEGER NOT NULL,
    language TEXT NOT NULL,
    currency TEXT NOT NULL
);

selectSettings:
SELECT * FROM SettingsEntity WHERE id = 1;

upsertSettings:
INSERT OR REPLACE INTO SettingsEntity(id, darkModeEnabled, language, currency)
VALUES (1, ?, ?, ?);
