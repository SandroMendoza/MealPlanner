-- Where the user put an item on the shopping list, by ingredient name, so later lists keep it
-- there. Items without a row fall back to the pantry staple default.
CREATE TABLE ShoppingAtHomeEntity (
    normalizedName TEXT NOT NULL PRIMARY KEY,
    atHome INTEGER NOT NULL
);

selectAll:
SELECT * FROM ShoppingAtHomeEntity;

setAtHome:
INSERT OR REPLACE INTO ShoppingAtHomeEntity(normalizedName, atHome) VALUES (:normalizedName, :atHome);
