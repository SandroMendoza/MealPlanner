CREATE TABLE ShoppingGroupEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sortOrder INTEGER NOT NULL
);

selectAllGroups:
SELECT * FROM ShoppingGroupEntity ORDER BY sortOrder;

selectMaxSortOrder:
SELECT MAX(sortOrder) AS maxSortOrder FROM ShoppingGroupEntity;

insertGroup:
INSERT INTO ShoppingGroupEntity(id, name, sortOrder) VALUES (?, ?, ?);

renameGroup:
UPDATE ShoppingGroupEntity SET name = :name WHERE id = :id;

deleteGroup:
DELETE FROM ShoppingGroupEntity WHERE id = :id;
