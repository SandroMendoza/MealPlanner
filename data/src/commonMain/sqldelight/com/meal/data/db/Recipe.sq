CREATE TABLE RecipeEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    category TEXT NOT NULL,
    preparationTimeMinutes INTEGER NOT NULL,
    servings INTEGER NOT NULL,
    calories INTEGER,
    imageUrl TEXT,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    isUserCreated INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE RecipeMealTypeEntity (
    recipeId TEXT NOT NULL,
    mealType TEXT NOT NULL,
    FOREIGN KEY (recipeId) REFERENCES RecipeEntity(id)
);

CREATE TABLE RecipeIngredientEntity (
    id TEXT NOT NULL PRIMARY KEY,
    recipeId TEXT NOT NULL,
    ingredientId TEXT NOT NULL,
    quantity REAL NOT NULL,
    unit TEXT NOT NULL,
    FOREIGN KEY (recipeId) REFERENCES RecipeEntity(id),
    FOREIGN KEY (ingredientId) REFERENCES IngredientEntity(id)
);

CREATE TABLE InstructionEntity (
    recipeId TEXT NOT NULL,
    stepNumber INTEGER NOT NULL,
    description TEXT NOT NULL,
    PRIMARY KEY (recipeId, stepNumber),
    FOREIGN KEY (recipeId) REFERENCES RecipeEntity(id)
);

selectActiveRecipes:
SELECT * FROM RecipeEntity WHERE isDeleted = 0;

countAllRecipes:
SELECT COUNT(*) FROM RecipeEntity;

selectRecipeById:
SELECT * FROM RecipeEntity WHERE id = ?;

selectMealTypesForRecipe:
SELECT * FROM RecipeMealTypeEntity WHERE recipeId = ?;

selectRecipeIngredientsForRecipe:
SELECT
    RecipeIngredientEntity.id,
    RecipeIngredientEntity.quantity,
    RecipeIngredientEntity.unit,
    IngredientEntity.id AS ingredientId,
    IngredientEntity.name AS ingredientName
FROM RecipeIngredientEntity
JOIN IngredientEntity ON IngredientEntity.id = RecipeIngredientEntity.ingredientId
WHERE RecipeIngredientEntity.recipeId = ?;

selectInstructionsForRecipe:
SELECT * FROM InstructionEntity WHERE recipeId = ? ORDER BY stepNumber;

insertRecipe:
INSERT INTO RecipeEntity(id, name, description, category, preparationTimeMinutes, servings, calories, imageUrl, isDeleted, isUserCreated)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0, ?);

updateRecipe:
UPDATE RecipeEntity
SET name = ?, description = ?, category = ?, preparationTimeMinutes = ?, servings = ?, calories = ?, imageUrl = ?
WHERE id = ?;

softDeleteRecipe:
UPDATE RecipeEntity SET isDeleted = 1 WHERE id = ?;

updateFavorite:
UPDATE RecipeEntity SET isFavorite = ? WHERE id = ?;

insertMealType:
INSERT INTO RecipeMealTypeEntity(recipeId, mealType) VALUES (?, ?);

deleteMealTypesForRecipe:
DELETE FROM RecipeMealTypeEntity WHERE recipeId = ?;

insertRecipeIngredient:
INSERT INTO RecipeIngredientEntity(id, recipeId, ingredientId, quantity, unit) VALUES (?, ?, ?, ?, ?);

deleteRecipeIngredientsForRecipe:
DELETE FROM RecipeIngredientEntity WHERE recipeId = ?;

insertInstruction:
INSERT INTO InstructionEntity(recipeId, stepNumber, description) VALUES (?, ?, ?);

deleteInstructionsForRecipe:
DELETE FROM InstructionEntity WHERE recipeId = ?;
