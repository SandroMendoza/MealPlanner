CREATE TABLE ShoppingListItemEntity (
    itemKey TEXT NOT NULL,
    rangeStart TEXT NOT NULL,
    rangeEnd TEXT NOT NULL,
    name TEXT NOT NULL,
    quantity REAL,
    unit TEXT,
    checked INTEGER NOT NULL DEFAULT 0,
    removed INTEGER NOT NULL DEFAULT 0,
    price REAL,
    PRIMARY KEY (itemKey, rangeStart, rangeEnd)
);

selectActiveItems:
SELECT * FROM ShoppingListItemEntity
WHERE rangeStart = :rangeStart AND rangeEnd = :rangeEnd AND removed = 0
ORDER BY name;

selectKeysForRange:
SELECT itemKey FROM ShoppingListItemEntity WHERE rangeStart = :rangeStart AND rangeEnd = :rangeEnd;

selectOverlappingItems:
SELECT * FROM ShoppingListItemEntity
WHERE removed = 0
  AND rangeStart <= :rangeEnd
  AND rangeEnd >= :rangeStart;

insertItem:
INSERT INTO ShoppingListItemEntity(itemKey, rangeStart, rangeEnd, name, quantity, unit, checked, removed)
VALUES (?, ?, ?, ?, ?, ?, ?, 0);

selectActiveItemByName:
SELECT itemKey FROM ShoppingListItemEntity
WHERE rangeStart = :rangeStart AND rangeEnd = :rangeEnd AND removed = 0
  AND unit IS :unit AND lower(trim(name)) = :normalizedName
LIMIT 1;

addToQuantity:
UPDATE ShoppingListItemEntity SET quantity = quantity + :quantity
WHERE itemKey = :itemKey AND rangeStart = :rangeStart AND rangeEnd = :rangeEnd;

setChecked:
UPDATE ShoppingListItemEntity SET checked = :checked
WHERE itemKey = :itemKey AND removed = 0 AND rangeStart <= :rangeEnd AND rangeEnd >= :rangeStart;

setQuantityAndUnit:
UPDATE ShoppingListItemEntity SET quantity = :quantity, unit = :unit
WHERE itemKey = :itemKey AND rangeStart = :rangeStart AND rangeEnd = :rangeEnd;

setRemoved:
UPDATE ShoppingListItemEntity SET removed = 1 WHERE itemKey = :itemKey AND rangeStart = :rangeStart AND rangeEnd = :rangeEnd;

setItemPrice:
UPDATE ShoppingListItemEntity SET price = :price, checked = 1
WHERE itemKey = :itemKey AND removed = 0 AND rangeStart <= :rangeEnd AND rangeEnd >= :rangeStart;

selectPricedItemsInRange:
SELECT * FROM ShoppingListItemEntity
WHERE price IS NOT NULL
  AND removed = 0
  AND rangeStart <= :rangeEnd
  AND rangeEnd >= :rangeStart
ORDER BY rangeStart, name;
