-- Built-in recipes already on the device get the meal types they ship with, matched by their
-- bundled photo or, when the user changed the photo, by name.
CREATE TABLE RecipeMealTypeEntity (
    recipeId TEXT NOT NULL,
    mealType TEXT NOT NULL,
    FOREIGN KEY (recipeId) REFERENCES RecipeEntity(id)
);

INSERT INTO RecipeMealTypeEntity(recipeId, mealType)
SELECT id, 'BREAKFAST' FROM RecipeEntity
WHERE isUserCreated = 0 AND (imageUrl IN (
    'seed:arroz_caldo.webp',
    'seed:banh_mi.webp',
    'seed:beef_pho.webp',
    'seed:beef_tapa.webp',
    'seed:bo_kho.webp',
    'seed:buttermilk_pancakes.webp',
    'seed:champorado.webp',
    'seed:chicken_pho.webp',
    'seed:chicken_sopas.webp',
    'seed:chilaquiles.webp',
    'seed:churros.webp',
    'seed:cochinita_pibil.webp',
    'seed:com_tam.webp',
    'seed:daing_na_bangus.webp',
    'seed:doenjang_jjigae.webp',
    'seed:egg_tarts.webp',
    'seed:focaccia.webp',
    'seed:gyudon.webp',
    'seed:huevos_rancheros.webp',
    'seed:kimchi_fried_rice.webp',
    'seed:korean_seasoned_spinach.webp',
    'seed:korean_steamed_egg.webp',
    'seed:miso_soup.webp',
    'seed:shrimp_and_grits.webp',
    'seed:sinangag.webp',
    'seed:skinless_longganisa.webp',
    'seed:tamagoyaki.webp',
    'seed:tonjiru.webp',
    'seed:tortang_talong.webp',
    'seed:vietnamese_iced_coffee.webp',
    'seed:wonton_soup.webp'
) OR lower(trim(name)) IN (
    'arroz caldo',
    'banh mi',
    'beef pho',
    'beef tapa',
    'bo kho',
    'buttermilk pancakes',
    'champorado',
    'chicken pho',
    'chicken sopas',
    'chilaquiles',
    'churros',
    'cochinita pibil',
    'com tam',
    'daing na bangus',
    'doenjang jjigae',
    'egg tarts',
    'focaccia',
    'gyudon',
    'huevos rancheros',
    'kimchi fried rice',
    'korean seasoned spinach',
    'korean steamed egg',
    'miso soup',
    'shrimp and grits',
    'sinangag',
    'skinless longganisa',
    'tamagoyaki',
    'tonjiru',
    'tortang talong',
    'vietnamese iced coffee',
    'wonton soup'
));

