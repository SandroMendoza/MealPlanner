CREATE TABLE UserProfileEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    bio TEXT NOT NULL,
    avatarUrl TEXT NOT NULL
);

selectProfile:
SELECT * FROM UserProfileEntity WHERE id = 1;

upsertProfile:
INSERT OR REPLACE INTO UserProfileEntity(id, name, bio, avatarUrl)
VALUES (1, ?, ?, ?);

rewritePhotoPath:
UPDATE UserProfileEntity
SET avatarUrl = :photoDirUri || substr(avatarUrl, instr(avatarUrl, '/recipe_images/') + 15)
WHERE avatarUrl LIKE 'file://%/recipe_images/%';
